# Pairs with .gitattributes: that governs storage and checkout, this governs what
# the editor types. The two must agree extension for extension or they fight.
# NB: brace expansion IS valid here and is NOT valid in .gitattributes.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{bat,cmd,ps1,psm1,psd1,sln}]
end_of_line = crlf
